# JARVIS Environment Variables

# Anthropic API Key (Required for Claude Haiku - Step 2)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Speech-to-Text API Key (Cloud STT: Groq or OpenAI)
# Groq provides ultra-fast transcription (<300ms) to hit the <2s response target
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Picovoice (for wake-word in future steps)
PICOVOICE_ACCESS_KEY=your_picovoice_key_here
